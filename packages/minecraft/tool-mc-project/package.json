{
  "name": "@deepseek-ai/dsh-tool-mc-project",
  "description": "Model-facing Minecraft Gradle project detector for DeepSeek Harness mod-development agents",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
