{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron development shell supervising the existing dsh desktop application",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "files": [
    "lib",
    "dist"
  ],
  "build": {
    "appId": "ai.deepseek.craftcode",
    "productName": "CraftCode",
    "win": {
      "icon": "src/CraftCode.ico"
    },
    "linux": {
      "icon": "src/CraftCode.ico"
    }
  },
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/preload.cjs','lib/preload.cjs'); require('node:fs').copyFileSync('src/CraftCode.ico','lib/CraftCode.ico'); for(const file of ['annotation.html','annotation.css','annotation.js','annotation-preload.cjs']) require('node:fs').copyFileSync('src/'+file,'lib/'+file)\"",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "dev": "pnpm run build && electron .",
    "icon:generate": "node scripts/generate-icon.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-tool-mc-project": "workspace:^",
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "playwright": "^1.49.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-pwsh-local": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "fflate": "^0.8.2",
    "sharp": "^0.35.3"
  }
}
